[Unit]
Description=Conky audio spectrum (CAVA -> bridge -> Conky)
Documentation=file:%h/.config/conky/spectrum/start-spectrum.sh

# CAVA captures the default PulseAudio/PipeWire monitor source.
After=pipewire.service pipewire-pulse.service
Wants=pipewire-pulse.service

# Audio may not be ready at the very first login attempt.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.config/conky/spectrum/start-spectrum.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
